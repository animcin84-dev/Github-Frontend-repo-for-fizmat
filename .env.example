DATABASE_URL=
SUPPORT_DATA_MODE=mock

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback

# Exactly 32 bytes after Base64 or hex decoding. Generate locally; never commit the real value.
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_OAUTH_STATE_SECRET=

# Dedicated support-mailbox query. Keep development backfill intentionally bounded.
GMAIL_SYNC_QUERY="in:inbox newer_than:30d"
GMAIL_BACKFILL_DAYS=30
GMAIL_SYNC_MAX_THREADS=0

# Optional Gmail push / Cloud Pub/Sub.
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_AUDIENCE=
GMAIL_PUBSUB_SERVICE_ACCOUNT_EMAIL=
GMAIL_WATCH_LABEL_IDS=INBOX

# Default false. Local disconnect always removes the stored refresh token.
GMAIL_REVOKE_ON_DISCONNECT=false

# Official Meta WhatsApp Cloud API. Presence alone does not prove a connection.
# Ingestion requires database mode, app secret, phone number ID, and WABA ID.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
# Central Graph version for the future send adapter; no Graph calls in foundations.
WHATSAPP_API_VERSION=

# P2A: server-only structured triage. Never use NEXT_PUBLIC_ for provider keys.
AI_PRIMARY_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
HF_TOKEN=
# Explicit downstream route; automatic routing is intentionally disabled.
HF_MODEL=openai/gpt-oss-20b:novita
